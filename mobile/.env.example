# Copy to .env and fill in for local development.
#
# Expo Go on a physical phone cannot reach 127.0.0.1/localhost (that resolves
# to the phone itself), so point this at your dev machine's LAN IP instead,
# e.g. http://192.168.1.42:8000. Find your LAN IP with `ipconfig` (Windows)
# or `ifconfig`/`ip addr` (Mac/Linux). Make sure your phone is on the same
# Wi-Fi network as your dev machine, and Django is running with
# `python manage.py runserver 0.0.0.0:8000` (not just 127.0.0.1:8000) so it
# accepts connections from other devices on the network.
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# Production API (used for release builds).
# EXPO_PUBLIC_API_URL=https://api.nacosabuad.org

# Also add your LAN IP to backend/.env's DJANGO_ALLOWED_HOSTS (comma-separated),
# e.g. DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.42 — Django's DEBUG
# default only allows 127.0.0.1/localhost, so without this the phone's
# requests get a 400 "Invalid HTTP_HOST header" error.
